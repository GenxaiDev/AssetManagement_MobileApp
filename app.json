{
  "expo": {
    "name": "GenxAI Asset",
    "slug": "assetmanagement",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B1F3A",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A"
      },
      "package": "com.trusha_kyada.genxassetapp"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "0e7155e5-82fc-4367-adf0-934304e96490"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ]
  }
}
